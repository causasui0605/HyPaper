{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              292,
              365,
              420,
              493
            ]
          },
          "path": {
            "pattern": "^generic_capture/[^/].*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "mode",
          "path",
          "sha256",
          "size"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "package": {
      "const": "generic_capture"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "package",
    "members"
  ],
  "type": "object"
}
