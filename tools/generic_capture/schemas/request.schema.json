{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "argv": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "capture_root": {
      "minLength": 1,
      "type": "string"
    },
    "cwd": {
      "minLength": 1,
      "type": "string"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "type": "object"
    },
    "expected_return_codes": {
      "items": {
        "maximum": 255,
        "minimum": -255,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "argv",
    "cwd",
    "environment",
    "expected_return_codes",
    "capture_root"
  ],
  "type": "object"
}
